# PostgreSQL connection string for the API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitment_tracker"

# Google OAuth: configure the authorized web and mobile client IDs in the identity provider.
GOOGLE_CLIENT_IDS=""

# Exact Google account email allowed to bootstrap and retain the initial ADMIN role.
INITIAL_ADMIN_EMAIL=""

# API session signing key. Generate a unique secret for each environment.
SESSION_SECRET=""

# Exact web origin allowed to call the API. Native requests do not use browser CORS.
WEB_ORIGIN="http://localhost:5173"
PORT=4000
