# Copie este arquivo para .env antes de iniciar o Compose.
POSTGRES_DB=recruitment_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Dentro do Compose, o host do banco é o serviço "postgres".
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recruitment_tracker
DATABASE_SSL=false

# Crie um OAuth Client ID do tipo Web no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_EXTRA_CLIENT_IDS=
INITIAL_ADMIN_EMAIL=
SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
WEB_ORIGIN=http://localhost:8080

WEB_PORT=8080
API_PORT=4000
